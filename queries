CREATE TABLE audit_log (
log_id INT PRIMARY KEY AUTO_INCREMENT,
action_text VARCHAR(255),
action_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

DELIMITER //

CREATE TRIGGER user_insert_trigger
AFTER INSERT ON users
FOR EACH ROW
BEGIN
