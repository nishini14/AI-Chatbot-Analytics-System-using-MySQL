-- JOIN QUERY

SELECT 
u.username,
c.user_message,
c.ai_response,
e.detected_emotion,
r.risk_level
FROM users u
JOIN conversations c
ON u.user_id = c.user_id
JOIN emotion_analysis e
ON c.conversation_id = e.conversation_id
JOIN risk_detection r
ON c.conversation_id = r.conversation_id;


-- VIEW

CREATE VIEW chatbot_summary AS
SELECT
u.username,
c.user_message,
e.detected_emotion,
r.risk_level,
f.rating
FROM users u
JOIN conversations c
ON u.user_id = c.user_id
JOIN emotion_analysis e
ON c.conversation_id = e.conversation_id
JOIN risk_detection r
ON c.conversation_id = r.conversation_id
JOIN feedback_system f
ON c.conversation_id = f.conversation_id;

SELECT * FROM chatbot_summary;


