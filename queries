USE neurochat_system;
SHOW TABLES;
CREATE TABLE users (
    user_id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50),
    email VARCHAR(100),
    country VARCHAR(50),
    join_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE conversations (
    conversation_id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT,
    user_message TEXT,
    ai_response TEXT,
    response_time_ms INT,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id)
    REFERENCES users(user_id)
);

CREATE TABLE emotion_analysis (
    emotion_id INT PRIMARY KEY AUTO_INCREMENT,
    conversation_id INT,
    detected_emotion VARCHAR(50),
    confidence_score DECIMAL(5,2),

    FOREIGN KEY (conversation_id)
    REFERENCES conversations(conversation_id)
);

CREATE TABLE risk_detection (
    risk_id INT PRIMARY KEY AUTO_INCREMENT,
    conversation_id INT,
    risk_level VARCHAR(20),
    flagged_words VARCHAR(200),

    FOREIGN KEY (conversation_id)
    REFERENCES conversations(conversation_id)
);

CREATE TABLE feedback_system (
    feedback_id INT PRIMARY KEY AUTO_INCREMENT,
    conversation_id INT,
    rating INT,
    feedback_text VARCHAR(300),

    FOREIGN KEY (conversation_id)
    REFERENCES conversations(conversation_id)
);

CREATE TABLE ai_model_logs (
    model_id INT PRIMARY KEY AUTO_INCREMENT,
    conversation_id INT,
    tokens_used INT,
    accuracy_score DECIMAL(5,2),
    generated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (conversation_id)
    REFERENCES conversations(conversation_id)
);
